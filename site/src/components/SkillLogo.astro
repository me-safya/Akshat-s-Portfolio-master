---
import { skillIcons, skillKey } from "../lib/skills.js";

const { name } = Astro.props;
const icon = skillIcons[skillKey(name)];
---

<span aria-hidden="true" class:list={["skill-logo", icon?.dark && "skill-logo-dark"]}>
  {icon?.type === "svg" && (
    <svg viewBox="0 0 24 24" fill={icon.color}><path d={icon.path} /></svg>
  )}
  {icon?.type === "img" && <img src={icon.src} alt="" width="20" height="20" loading="lazy" />}
  {icon?.type === "glyph" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon.inner} />
  )}
  {!icon && name.slice(0, 1)}
</span>
